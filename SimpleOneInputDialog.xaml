<Window x:Class="PointCloudViz_Final.SimpleOneInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Height="150" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="LabelText" Margin="0,0,0,6"/>
        <TextBox Name="InputText" Grid.Row="1" Height="28"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="72" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="72" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
