<Window x:Class="PointCloudViz_Final.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="三维点云数据可视化 - PointCloudViz_Final" Height="720" Width="1100">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_文件">
                <MenuItem Header="打开点云... (XYZ, PLY)" Click="OpenPointCloud_Click"/>
                <MenuItem Header="保存点云为XYZ..." Click="SaveAsXyz_Click"/>
                <Separator/>
                <MenuItem Header="保存项目(.json)..." Click="SaveProject_Click"/>
                <MenuItem Header="打开项目(.json)..." Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_视图">
                <MenuItem Header="颜色映射">
                    <MenuItem Header="按高程" Click="ColorMapHeight_Click"/>
                    <MenuItem Header="按强度" Click="ColorMapIntensity_Click"/>
                </MenuItem>
                <MenuItem Header="背景颜色">
                    <MenuItem Header="黑色" Click="BackgroundBlack_Click"/>
                    <MenuItem Header="白色" Click="BackgroundWhite_Click"/>
                    <MenuItem Header="灰色" Click="BackgroundGray_Click"/>
                </MenuItem>
                <MenuItem Header="动态LOD" IsCheckable="True" IsChecked="True" Click="ToggleLod_Click" Name="LodMenuItem"/>
                <MenuItem Header="重置视角" Click="ResetView_Click"/>
            </MenuItem>
            <MenuItem Header="_过滤">
                <MenuItem Header="Z范围过滤..." Click="FilterZ_Click"/>
                <MenuItem Header="体素下采样(Voxel)..." Click="VoxelDownsample_Click"/>
                <MenuItem Header="半径离群点剔除..." Click="RadiusOutlier_Click"/>
                <MenuItem Header="恢复原始数据" Click="RestoreOriginal_Click"/>
                <Separator/>
                <MenuItem Header="撤销" Click="Undo_Click" Name="UndoMenuItem"/>
                <MenuItem Header="重做" Click="Redo_Click" Name="RedoMenuItem"/>
            </MenuItem>
            <MenuItem Header="_工具">
                <MenuItem Header="统计信息" Click="ShowStats_Click"/>
                <Separator/>
                <MenuItem Header="测量工具">
                    <MenuItem Header="测距模式" Click="MeasurementDistance_Click" IsCheckable="True" Name="MeasurementDistanceMenuItem"/>
                    <MenuItem Header="测面积模式" Click="MeasurementArea_Click" IsCheckable="True" Name="MeasurementAreaMenuItem"/>
                    <MenuItem Header="清除测量" Click="ClearMeasurements_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="生成合成街景点云..." Click="GenerateSynthetic_Click"/>
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Header="使用说明" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="测试渲染（调试用）" Click="TestRender_Click"/>
                <Separator/>
                <MenuItem Header="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="点大小:" Margin="8,0,4,0"/>
                    <Slider Minimum="1" Maximum="8" Value="3" Width="150" ValueChanged="PointSizeSlider_ValueChanged"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8">
                <GroupBox Header="项目">
                    <StackPanel>
                        <TextBlock Text="当前文件:" FontWeight="Bold"/>
                        <TextBlock Name="CurrentFileText" Text="(未打开)" TextWrapping="Wrap"/>
                        <Separator/>
                        <TextBlock Text="点数:" FontWeight="Bold"/>
                        <TextBlock Name="PointCountText" Text="0"/>
                        <TextBlock Text="范围(BBox):" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Name="BBoxText" Text="-"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="操作提示" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="鼠标左键旋转，右键平移，滚轮缩放。" TextWrapping="Wrap"/>
                        <TextBlock Text="WASD: 移动视角" Margin="0,4,0,0" FontSize="10" Foreground="Gray"/>
                        <TextBlock Text="QE: 上下移动" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <hx:Viewport3DX Grid.Column="1" 
                             x:Name="Viewport3D"
                             BackgroundColor="Black" 
                             ShowCoordinateSystem="False"
                             ZoomExtentsWhenLoaded="False"
                             EnableSwapChainRendering="True"
                             UseDefaultGestures="False"
                             EnableMouseButtonHitTest="False"
                             Focusable="True"
                             PreviewMouseDown="Viewport3D_PreviewMouseDown"
                             PreviewMouseMove="Viewport3D_PreviewMouseMove"
                             PreviewMouseUp="Viewport3D_PreviewMouseUp"
                             PreviewMouseWheel="Viewport3D_PreviewMouseWheel"
                             MouseWheel="Viewport3D_MouseWheel">
                
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera x:Name="HelixCamera" 
                                          Position="0,0,100" 
                                          LookDirection="0,0,-100" 
                                          UpDirection="0,1,0"
                                          FarPlaneDistance="100000"
                                          NearPlaneDistance="0.01"
                                          FieldOfView="45"/>
                </hx:Viewport3DX.Camera>

                <!-- 添加DirectionalLight以确保可见性 -->
                <hx:DirectionalLight3D Direction="0,-1,-1" Color="White"/>
                <hx:DirectionalLight3D Direction="0,1,1" Color="White"/>
                <hx:AmbientLight3D Color="White"/>
                
                <hx:PointGeometryModel3D x:Name="PointModel" 
                                         Color="White"
                                         FigureRatio="0.5"
                                         FixedSize="True">
                    <hx:PointGeometryModel3D.Geometry>
                        <hx:PointGeometry3D x:Name="PointGeometry"/>
                    </hx:PointGeometryModel3D.Geometry>
                </hx:PointGeometryModel3D>

                <!-- 测量线段与辅助线 -->
                <hx:LineGeometryModel3D x:Name="MeasurementLineModel"
                                        Color="Yellow"
                                        Thickness="2"
                                        IsHitTestVisible="False"/>
                <hx:LineGeometryModel3D x:Name="MeasurementHelperLineModel"
                                        Color="#66A7D8FF"
                                        Thickness="1.5"
                                        IsHitTestVisible="False"/>
                
                <!-- 已选点/测量点高亮 -->
                <hx:PointGeometryModel3D x:Name="MeasurementMarkerModel"
                                         Color="Orange"
                                         Size="10,10"
                                         FixedSize="True"
                                         IsHitTestVisible="False"/>
                
            </hx:Viewport3DX>

            <!-- 顶部通知条，提示重要状态 -->
            <Border Grid.ColumnSpan="2"
                    x:Name="NotificationPanel"
                    Background="#EE333333"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.5"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,12,16,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Panel.ZIndex="10">
                <TextBlock x:Name="NotificationText"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
