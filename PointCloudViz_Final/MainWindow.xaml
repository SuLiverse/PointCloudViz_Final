<Window x:Class="PointCloudViz_Final.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="PointCloud Studio" Width="1440" Height="900" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_KeyDown">
    <Grid>
        <DockPanel x:Name="Workspace">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Height="56" Margin="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE809;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="25" Margin="0,0,12,0"/>
                        <TextBlock Text="PointCloud" FontWeight="SemiBold" FontSize="21"/>
                        <TextBlock Text=" Studio" FontSize="21" Foreground="{StaticResource Muted}"/>
                        <Border Background="#E4F2ED" CornerRadius="3" Padding="7,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="2.0" FontSize="10" Foreground="#087F72" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="DocumentTitle" Text="未命名场景" Foreground="{StaticResource Muted}" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" / " Foreground="#C3CCCF" Margin="12,0"/>
                        <TextBlock Text="SuLi" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Menu DockPanel.Dock="Top" Background="#F5F7F8" Padding="14,4">
                <MenuItem Header="文件">
                    <MenuItem Header="打开点云..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                    <MenuItem Header="打开项目..." Click="OpenProject_Click"/>
                    <MenuItem Header="保存项目快照..." InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                    <Separator/>
                    <MenuItem Header="导出点云..." Click="ExportCloud_Click"/>
                    <MenuItem Header="导出视口 PNG..." Click="Screenshot_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="编辑">
                    <MenuItem Header="撤销" InputGestureText="Ctrl+Z" x:Name="UndoMenu" Click="Undo_Click"/>
                    <MenuItem Header="重做" InputGestureText="Ctrl+Y" x:Name="RedoMenu" Click="Redo_Click"/>
                    <MenuItem Header="恢复原始点云" Click="Restore_Click"/>
                </MenuItem>
                <MenuItem Header="视图">
                    <MenuItem Header="适应窗口" InputGestureText="F" Click="Fit_Click"/>
                    <MenuItem Header="等轴测" Tag="iso" Click="Preset_Click"/>
                    <MenuItem Header="俯视 XY" Tag="top" Click="Preset_Click"/>
                    <MenuItem Header="正视 XZ" Tag="front" Click="Preset_Click"/>
                </MenuItem>
                <MenuItem Header="示例">
                    <MenuItem Header="合成街区" Click="Demo_Click"/>
                    <MenuItem Header="课程原始样例" Click="OriginalSample_Click"/>
                </MenuItem>
                <MenuItem Header="关于" Click="About_Click"/>
            </Menu>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="14,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="导出视口 PNG" Click="Screenshot_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="保存项目快照 (Ctrl+S)" Click="SaveProject_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Click="Open_Click" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" Margin="0,0,8,0"/><TextBlock Text="打开点云"/></StackPanel>
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="撤销 (Ctrl+Z)" Click="Undo_Click"/>
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="重做 (Ctrl+Y)" Click="Redo_Click"/>
                        <Border Width="1" Background="{StaticResource Line}" Margin="12,3"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" ToolTip="适应窗口 (F)" Click="Fit_Click"/>
                        <ComboBox x:Name="ViewPreset" Width="98" Margin="8,0,12,0" SelectionChanged="ViewPreset_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="等轴测" Tag="iso"/><ComboBoxItem Content="俯视 XY" Tag="top"/><ComboBoxItem Content="正视 XZ" Tag="front"/>
                        </ComboBox>
                        <Border Width="1" Background="{StaticResource Line}" Margin="0,3,16,3"/>
                        <RadioButton x:Name="NavigateMode" GroupName="Mode" Content="浏览" IsChecked="True" VerticalAlignment="Center" Checked="Mode_Changed" Tag="None"/>
                        <RadioButton x:Name="DistanceMode" GroupName="Mode" Content="测距" VerticalAlignment="Center" Checked="Mode_Changed" Tag="Distance"/>
                        <RadioButton x:Name="AreaMode" GroupName="Mode" Content="面积" VerticalAlignment="Center" Checked="Mode_Changed" Tag="Area"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE73E;" ToolTip="结束当前选点 (Enter)" Click="FinishMeasurement_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="#EDF2F2" Padding="16,7" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#087F72" Margin="12,0,7,0"/>
                        <TextBlock x:Name="RendererStatus" Text="DirectX 11" FontSize="10" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="坐标单位: u" FontSize="10" Foreground="{StaticResource Muted}" Margin="18,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="258"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#F8FAFA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,20">
                            <TextBlock Text="场景资源" Style="{StaticResource Section}"/>
                            <Border Background="#E7F1EE" BorderBrush="#CDE3DB" BorderThickness="1" CornerRadius="4" Padding="10">
                                <DockPanel>
                                    <CheckBox x:Name="CloudVisible" IsChecked="True" ToolTip="显示点云" Click="Visibility_Click" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="CurrentFileText" Text="未加载" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="当前点数" Foreground="{StaticResource Muted}" Margin="0,24,0,5" FontSize="11"/>
                            <TextBlock x:Name="PointCountText" Text="0" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OriginalCountText" Text="原始 0" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                            <Separator/>
                            <TextBlock Text="空间范围" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="ExtentText" Text="X  -&#10;Y  -&#10;Z  -" Style="{StaticResource Mono}" LineHeight="23"/>
                            <TextBlock Text="坐标原点" Foreground="{StaticResource Muted}" Margin="0,14,0,7" FontSize="11"/>
                            <TextBlock x:Name="OriginText" Text="-" Style="{StaticResource Mono}" TextWrapping="Wrap" LineHeight="20"/>
                            <Separator/>
                            <TextBlock Text="高程分布" Style="{StaticResource Section}"/>
                            <Grid x:Name="Histogram" Height="68" Background="Transparent"/>
                            <DockPanel Margin="0,6,0,12">
                                <TextBlock x:Name="HeightMaxText" DockPanel.Dock="Right" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="HeightMinText" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                            </DockPanel>
                            <TextBlock x:Name="StatisticsText" Text="-" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="22"/>
                            <Separator/>
                            <TextBlock Text="最近打开" Style="{StaticResource Section}"/>
                            <ItemsControl x:Name="RecentFiles">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Recent_Click" Tag="{Binding}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="8,5" ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Width="154" FontSize="11"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="Demo_Click" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="合成街区"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="156"/></Grid.RowDefinitions>
                    <Grid x:Name="ViewportHost" Background="#171B1E" ClipToBounds="True">
                        <hx:Viewport3DX x:Name="Viewport" BackgroundColor="#171B1E" ShowCoordinateSystem="True"
                            CoordinateSystemLabelForeground="White" ShowViewCube="False" ZoomExtentsWhenLoaded="False" UseDefaultGestures="False"
                            EnableMouseButtonHitTest="False" EnableSwapChainRendering="False" Focusable="True"
                            PreviewMouseDown="Viewport_MouseDown" PreviewMouseMove="Viewport_MouseMove"
                            PreviewMouseUp="Viewport_MouseUp" PreviewMouseWheel="Viewport_MouseWheel">
                            <hx:Viewport3DX.Camera>
                                <hx:PerspectiveCamera x:Name="SceneCamera" Position="60,-70,55" LookDirection="-60,70,-55"
                                    UpDirection="0,0,1" NearPlaneDistance="0.01" FarPlaneDistance="1000000" FieldOfView="45"/>
                            </hx:Viewport3DX.Camera>
                            <hx:AmbientLight3D Color="White"/>
                            <hx:LineGeometryModel3D x:Name="GridModel" Color="#343F44" Thickness="0.6" IsHitTestVisible="False"/>
                            <hx:PointGeometryModel3D x:Name="PointModel" Color="White" Size="2,2" FixedSize="True" FigureRatio="0.8"/>
                            <hx:LineGeometryModel3D x:Name="MeasurementLines" Color="#FFD166" Thickness="2" IsHitTestVisible="False"/>
                            <hx:PointGeometryModel3D x:Name="MeasurementMarkers" Color="#FFD166" Size="9,9" FixedSize="True" IsHitTestVisible="False"/>
                        </hx:Viewport3DX>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="20,17" IsHitTestVisible="False">
                            <Ellipse Width="6" Height="6" Fill="#65C7AF" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SceneLabel" Text="场景 / 合成街区" Foreground="#D6E2E3" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="RenderCountText" Text="" Foreground="#9DAEB2" FontFamily="Consolas" FontSize="11"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,16" IsHitTestVisible="False"/>
                        <Border x:Name="LegendPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,20,0"
                            IsHitTestVisible="False" Background="#BB171B1E" Padding="8" CornerRadius="3">
                            <StackPanel>
                                <TextBlock x:Name="LegendMax" Foreground="#D6E2E3" FontSize="10" HorizontalAlignment="Center"/>
                                <Rectangle Width="10" Height="100" Margin="0,8">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#285E91" Offset="0"/><GradientStop Color="#34B6B1" Offset=".3"/>
                                        <GradientStop Color="#90D19A" Offset=".55"/><GradientStop Color="#F2D66E" Offset=".8"/><GradientStop Color="#E38268" Offset="1"/>
                                    </LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock x:Name="LegendMin" Foreground="#D6E2E3" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TabControl Grid.Row="1">
                        <TabItem Header="操作记录">
                            <DataGrid x:Name="HistoryGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80"/>
                                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="*"/>
                                    <DataGridTextColumn Header="点数" Binding="{Binding Count}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="测量结果" x:Name="MeasurementTab">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="6" VerticalAlignment="Top">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="清除测量" Click="ClearMeasurements_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="导出测量 CSV" Click="ExportMeasurements_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="MeasurementGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/>
                                        <DataGridTextColumn Header="测量值 (u / u²)" Binding="{Binding Value, StringFormat=F3}" Width="*"/>
                                        <DataGridTextColumn Header="点数" Binding="{Binding Points.Count}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <TextBlock Text="显示属性" Style="{StaticResource Section}"/>
                            <TextBlock Text="颜色映射" FontSize="11" Margin="0,0,0,9"/>
                            <ComboBox x:Name="ColorMode" SelectedIndex="0" SelectionChanged="ColorMode_Changed">
                                <ComboBoxItem Content="高程 / Elevation" Tag="Height"/>
                                <ComboBoxItem Content="原始颜色 / RGB" Tag="RGB"/>
                                <ComboBoxItem Content="强度 / Intensity" Tag="Intensity"/>
                            </ComboBox>
                            <DockPanel Margin="0,19,0,8">
                                <TextBlock x:Name="PointSizeText" Text="2 px" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="点大小" FontSize="11"/>
                            </DockPanel>
                            <Slider x:Name="PointSizeSlider" Minimum="1" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PointSize_Changed"/>
                            <TextBlock Text="背景" FontSize="11" Margin="0,18,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="27" Height="27" MinHeight="27" Padding="0" Background="#171B1E" Tag="#171B1E" Click="Background_Click" ToolTip="石墨黑" Margin="0,0,10,0"/>
                                <Button Width="27" Height="27" MinHeight="27" Padding="0" Background="#FFFFFF" Tag="#FFFFFF" Click="Background_Click" ToolTip="白色" Margin="0,0,10,0"/>
                                <Button Width="27" Height="27" MinHeight="27" Padding="0" Background="#5D666C" Tag="#5D666C" Click="Background_Click" ToolTip="中灰"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowGrid" Content="参考网格" IsChecked="True" Click="Grid_Click" Margin="0,16,0,4"/>
                            <CheckBox x:Name="RenderBudget" Content="渲染预算 · 1,000,000 点" IsChecked="True" Click="Budget_Click" FontSize="11"/>
                            <Separator/>
                            <TextBlock Text="点云处理" Style="{StaticResource Section}"/>
                            <TextBlock Text="体素下采样" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="应用体素下采样" Click="Voxel_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="VoxelInput" Text="0.25" ToolTip="体素边长 (u)"/>
                            </DockPanel>
                            <Separator Margin="0,15"/>
                            <TextBlock Text="高程裁剪" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="MinZInput" Text="0" ToolTip="最小 Z"/>
                                <TextBlock Grid.Column="1" Text=":" HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="MaxZInput" Text="10" ToolTip="最大 Z"/>
                            </Grid>
                            <Button Click="Range_Click" Margin="0,8,0,0" Content="应用裁剪"/>
                            <Separator Margin="0,15"/>
                            <TextBlock Text="半径离群点剔除" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="半径 (u)" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="RadiusInput" Text="0.5"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="最少邻居" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="NeighborsInput" Text="6"/></StackPanel>
                            </Grid>
                            <Button Click="Outlier_Click" Margin="0,8,0,0" Content="剔除离群点"/>
                            <Button Click="Restore_Click" Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE777;" Margin="0,0,8,0"/><TextBlock Text="恢复原始点云"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
        <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#880D1517">
            <Border Background="White" Padding="28" Width="350" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LoadingText" Text="正在处理" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="LoadingProgress" Height="4" Margin="0,22,0,18" IsIndeterminate="True" Foreground="#087F72"/>
                    <Button Content="取消" Click="Cancel_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
