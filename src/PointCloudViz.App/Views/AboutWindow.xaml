<Window x:Class="PointCloudViz.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 PointCloudViz" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Assets/app.ico" Width="56" Height="56" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PointCloudViz" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Opacity="0.7"/>
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            基于 C# / WPF / .NET 的三维点云可视化与量测工具。支持 LAS 1.0–1.4、PLY、XYZ 读写，
            体素下采样、统计/半径离群点剔除、分类显示，以及坐标、距离、折线和面积量测。
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12">
            项目起源于面向对象程序设计课程期末作品。
            2.0 版本进行了架构重构：核心算法独立为跨平台类库并配有单元测试。
        </TextBlock>
        <TextBlock Opacity="0.75" Margin="0,0,0,16">
            渲染：HelixToolkit.Wpf.SharpDX（DirectX 11） · 界面：WPF Fluent
        </TextBlock>
        <TextBlock>
            <Hyperlink NavigateUri="https://github.com/SuLiverse/PointCloudViz_Final" RequestNavigate="Hyperlink_RequestNavigate">
                github.com/SuLiverse/PointCloudViz_Final
            </Hyperlink>
        </TextBlock>
        <Button Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="88" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
